@model E_Store_Sentiment_Analysis_Thesis.Models.Product

<div class="container mt-4">
    <div class="row">
        <div class="col-md-6">
            <h2>@Model.Name</h2>
            <div class="card p-3 shadow-sm">
                <p><strong>Kategoria:</strong> @Model.Category?.Name</p>
                <p><strong>Cena:</strong> <span class="text-success h4">@(Model.Price?.ToString("C") ?? "Brak ceny")</span></p>
                <p><strong>Na stanie:</strong> @(Model.Stock ?? 0)</p>
                <p><strong>Opis:</strong></p>
                <p class="text-muted">@Model.Description</p>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary mt-3">← Powrót do listy</a>
        </div>

        <div class="col-md-6">
            <h3>Opinie o tym produkcie</h3>

            @if (User.Identity.IsAuthenticated)
            {
                <form asp-action="AddProductReview" method="post" class="mb-4">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <div class="form-group mb-2">
                        <textarea name="text" class="form-control" placeholder="Co sądzisz o tym produkcie?" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary btn-sm">Dodaj opinię</button>
                </form>
            }
            else
            {
                <p class="alert alert-info">Zaloguj się, aby dodać opinię.</p>
            }

            <div class="review-list">
                @if (Model.Reviews != null && Model.Reviews.Any())
                {
                    @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="review d-flex mb-3 p-3 border rounded bg-light shadow-sm">
                            <div class="me-3">
                                <div class="avatar bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center" style="width:40px; height:40px;">
                                    @review.User?.FirstName?[0]
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between">
                                    <strong>@review.User?.FirstName</strong>
                                    <small class="text-muted">@review.CreatedAt.ToString("dd.MM.yyyy")</small>
                                </div>
                                <p class="mb-0 mt-1">@review.Text</p>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted italic">Brak opinii o tym produkcie. Bądź pierwszy!</p>
                }
            </div>
        </div>
    </div>
</div>