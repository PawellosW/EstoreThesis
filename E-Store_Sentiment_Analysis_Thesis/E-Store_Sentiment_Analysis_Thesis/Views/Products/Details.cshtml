@model E_Store_Sentiment_Analysis_Thesis.Models.Product

@{
    ViewData["Title"] = "Szczegóły produktu";
}

<h2>@Model.Name</h2>

<div>
    <p><strong>Kategoria:</strong> @Model.Category?.Name</p>
    <p><strong>Cena:</strong> @(Model.Price?.ToString("C") ?? "Brak ceny")</p>
    <p><strong>Na stanie:</strong> @(Model.Stock ?? 0)</p>
    <p><strong>Opis:</strong> @Model.Description</p>
    <p><strong>Data dodania:</strong> @Model.CreatedAt.ToShortDateString()</p>
</div>

<hr />

<a asp-action="Index">← Powrót do listy produktów</a>