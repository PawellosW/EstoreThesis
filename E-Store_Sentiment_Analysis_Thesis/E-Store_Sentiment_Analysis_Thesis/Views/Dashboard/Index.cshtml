@model E_Store_Sentiment_Analysis_Thesis.ViewModels.DashboardViewModel

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 100vh;">

    <!-- HEADER -->
    <div class="card border-0 shadow-sm p-4 mb-4"
         style="border-radius:15px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="d-flex justify-content-between align-items-center text-white">
            <div>
                <span class="badge bg-warning text-dark fw-bold mb-2">Moduł analizy opinii klientów</span>
                <h2 class="fw-bold mb-1">Panel Analityczny</h2>
                
            </div>
            <form asp-action="TriggerAnalysis" method="post" id="analysisForm">
                <button type="submit" class="btn btn-light text-primary fw-bold px-4 py-2 shadow-sm"
                        id="btnRun" style="border-radius:10px;">
                    <i class="fas fa-play me-2 text-warning"></i> Uruchom analizę
                </button>
            </form>
        </div>
        <div class="mt-3 d-flex gap-4 text-white small">

            <span class="opacity-75 me-5">
                <i class="fas fa-tags me-1"></i>
                Opinii oczekujących na analizę aspektową:
                <strong class="text-warning">@Model.PendingLevel1Count</strong>
            </span>

            <span class="opacity-75">
                <i class="fas fa-exclamation-triangle me-1"></i>
                Opinii oczekujących na analizę alertową:
                <strong class="text-danger">@Model.PendingLevel2Count</strong>
            </span>
        </div>
        <div id="loadingStatus" class="mt-3 text-white d-none">
            <div class="spinner-border spinner-border-sm text-warning" role="status"></div>
            <span class="ms-2 small opacity-90">Przetwarzanie potoku LLM...</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
<div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
    <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>}

    <!-- STAT CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-radius:15px; border-left:5px solid #0d6efd !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold mb-1">Poziom 1 — Aspekty</h6>
                        <h2 class="display-6 fw-bold text-dark mb-0">@Model.TotalAspectsAnalyzed</h2>
                        <p class="text-muted small mb-1">łącznie w historii</p>
                        
                    </div>
                    <div class="bg-primary bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-layer-group text-primary fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-radius:15px; border-left:5px solid #6c757d !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold mb-1">Poziom 2 — Alerty</h6>
                        <h2 class="display-6 fw-bold text-dark mb-0">@Model.TotalAlertsAnalyzed</h2>
                        <p class="text-muted small mb-1">łącznie w historii</p>
                       
                    </div>
                    <div class="bg-secondary bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-shield-alt text-secondary fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-radius:15px; border-left:5px solid #dc3545 !important;">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase text-muted small fw-bold mb-1">Status: Pilne</h6>
                        <h2 class="display-6 fw-bold text-danger mb-0">@Model.UrgentReviewsCount</h2>
                        <p class="text-muted small mb-1">wymaga reakcji</p>
                        
                    </div>
                    <div class="bg-danger bg-opacity-10 p-3 rounded-3">
                        <i class="fas fa-exclamation-triangle text-danger fa-2x"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- OVERALL + ASPEKTY -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm p-4 h-100 text-center"
                 style="border-radius:15px; background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
                <h6 class="text-uppercase small text-white opacity-75 mb-3">Wskaźnik Satysfakcji</h6>
                <h1 class="display-3 fw-bold text-warning mb-0">@Model.AverageOverall</h1>
                <p class="text-white opacity-75 mb-3">/ 5.0</p>
                <div class="progress mx-3"
                     style="height:10px; background-color:rgba(255,255,255,0.2); border-radius:5px;">
                    <div class="progress-bar bg-warning"
                         style="width:@(Model.AverageOverall * 20)%"></div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card border-0 shadow-sm p-4 h-100" style="border-radius:15px;">
                <h5 class="fw-bold text-dark mb-4">
                    <i class="fas fa-star-half-alt me-2 text-warning"></i>Średnie oceny aspektów
                </h5>
                @{ var aspects = new[] {
                        new { Label = "Jakość produktu",    Value = Model.AverageQuality,  Color = "bg-success" },
                        new { Label = "Poziom cenowy",      Value = Model.AveragePrice,    Color = "bg-info"    },
                        new { Label = "Logistyka i dostawa",Value = Model.AverageDelivery, Color = "bg-primary" },
                        new { Label = "Obsługa klienta",    Value = Model.AverageService,  Color = "bg-warning" }
                    }; }
                @foreach (var aspect in aspects)
                {
    <div class="mb-3">
        <div class="d-flex justify-content-between small mb-1">
            <span class="fw-bold text-secondary">@aspect.Label</span>
            <span class="fw-bold text-dark">@aspect.Value / 5.0</span>
        </div>
        <div class="progress" style="height:8px; border-radius:5px;">
            <div class="progress-bar @aspect.Color"
                 style="width:@(aspect.Value * 20)%"></div>
        </div>
    </div>}
            </div>
        </div>

    </div>

    <!-- TABELA ALERTÓW -->
    @if (Model.UrgentReviews != null && Model.UrgentReviews.Any())
    {
<div class="row g-4">
    <div class="col-12">
        <div class="card border-0 shadow-sm p-4" style="border-radius:15px;">
            <h5 class="fw-bold text-danger mb-4">
                <i class="fas fa-exclamation-triangle me-2"></i>
                Opinie wymagające natychmiastowej reakcji (@Model.UrgentReviews.Count)
            </h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th style="width:80px">ID</th>
                            <th>Treść opinii</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model.UrgentReviews)
                        {
        <tr>
            <td>
                <span class="badge bg-danger">#@review.ReviewId</span>
            </td>
            <td class="text-muted small">@review.ReviewText</td>
        </tr>}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>}

</div>

<script>
    document.getElementById('analysisForm').onsubmit = function () {
        document.getElementById('btnRun').disabled = true;
        document.getElementById('loadingStatus').classList.remove('d-none');
    };
</script>