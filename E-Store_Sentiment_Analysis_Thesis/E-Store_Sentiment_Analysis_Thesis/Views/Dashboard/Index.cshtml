@model E_Store_Sentiment_Analysis_Thesis.ViewModels.DashboardViewModel
@using System.Globalization

@{
    var demoMode = true;

    var aspects = new[] {
        new { Label = "Jakość produktu",     Value = Model.AverageQuality,  Color = "bg-success" },
        new { Label = "Ocena ceny",          Value = Model.AveragePrice,    Color = "bg-info"    },
        new { Label = "Logistyka i dostawa", Value = Model.AverageDelivery, Color = "bg-primary" },
        new { Label = "Obsługa klienta",     Value = Model.AverageService,  Color = "bg-warning" }
    };

    
    var rated = aspects.Where(a => a.Value > 0).Select(a => a.Value).ToList();
    var satisfaction = rated.Any() ? Math.Round(rated.Average(), 2) : 0m;

    var totalReviews = Model.TotalAnalyzedReviews + Model.PendingLevel1Count;
}

<div class="container-fluid py-4" style="background-color: #f8f9fa; min-height: 100vh;">


    <div class="card border-0 shadow-sm p-4 mb-4"
         style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
        <div class="d-flex justify-content-between align-items-center text-white">
            <div>
                <h2 class="font-weight-bold mb-1 text-white">Panel analityczny</h2>
                <div class="text-white-50 small">
                    Opinii oczekujących na analizę:
                    <strong class="text-warning">@Model.PendingLevel1Count</strong>
                </div>
            </div>
            <form asp-action="TriggerAnalysis" method="post" id="analysisForm">
                <button type="submit" class="btn btn-light text-primary font-weight-bold px-4 py-2 shadow-sm"
                        id="btnRun" disabled="@demoMode">
                    Uruchom analizę
                </button>
            </form>
        </div>
        
    </div>
    @if (demoMode)
    {
        <div class="alert alert-info mb-4" role="alert">
            <h6 class="alert-heading font-weight-bold">Wersja demonstracyjna</h6>
            <p class="mb-2">Uruchamianie analizy w wersji demonstracyjnej jest wyłączone.</p>
            <ul class="small mb-0">
                <li>Moduł korzysta z lokalnego modelu językowego Bielik 4.5B (ok. 5 GB), który nie mieści się w darmowym hostingu.</li>
                <li>Wyniki w panelu pochodzą z rzeczywistego procesu analizy, przeprowadzonego na zbiorze testowym.</li>
                
            </ul>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
            @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Zamknij">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    
    <div class="row">

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-left:5px solid #0d6efd !important;">
                <h6 class="text-uppercase text-muted small font-weight-bold mb-1">Przeanalizowane opinie</h6>
                <h2 class="font-weight-bold text-dark mb-0">@Model.TotalAnalyzedReviews</h2>
                <p class="text-muted small mb-0">z @totalReviews wszystkich opinii</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-left:5px solid #dc3545 !important;">
                <h6 class="text-uppercase text-muted small font-weight-bold mb-1">Alerty</h6>
                <h2 class="font-weight-bold text-danger mb-0">@Model.UrgentReviewsCount</h2>
                <p class="text-muted small mb-0">opinii wymaga reakcji</p>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100 border-0 shadow-sm p-4"
                 style="border-left:5px solid #ffc107 !important;">
                <h6 class="text-uppercase text-muted small font-weight-bold mb-1">Wskaźnik satysfakcji</h6>
                @if (satisfaction > 0)
                {
                    <h2 class="font-weight-bold text-dark mb-0">
                        @satisfaction.ToString("0.00") <small class="text-muted">/ 5</small>
                    </h2>
                }
                else
                {
                    <h2 class="font-weight-bold text-muted mb-0">brak danych</h2>
                }
                <p class="text-muted small mb-0">średnia z ocen aspektów</p>
            </div>
        </div>

    </div>

   
    @if (Model.UrgentReviews != null && Model.UrgentReviews.Any())
    {
        <div class="card border-0 shadow-sm p-4 mb-4">
            <h5 class="font-weight-bold text-danger mb-4">
                Opinie wymagające natychmiastowej reakcji (@Model.UrgentReviews.Count)
            </h5>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="thead-light">
                        <tr>
                            <th style="width:80px">ID</th>
                            <th>Treść opinii</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var review in Model.UrgentReviews)
                        {
                            <tr>
                                <td><span class="badge badge-danger">#@review.ReviewId</span></td>
                                <td class="text-muted small">@review.ReviewText</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

  
    <div class="card border-0 shadow-sm p-4">
        <h5 class="font-weight-bold text-dark mb-4">Średnie oceny aspektów</h5>
        @foreach (var aspect in aspects)
        {
            <div class="mb-3">
                <div class="d-flex justify-content-between small mb-1">
                    <span class="font-weight-bold text-secondary">@aspect.Label</span>
                    @if (aspect.Value > 0)
                    {
                        <span class="font-weight-bold text-dark">@aspect.Value.ToString("0.00") / 5</span>
                    }
                    else
                    {
                        <span class="text-muted">brak danych</span>
                    }
                </div>
                <div class="progress" style="height:8px;">
                    <div class="progress-bar @aspect.Color"
                         style="width:@((aspect.Value * 20).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                </div>
            </div>
        }
    </div>

</div>

