@model IEnumerable<E_Store_Sentiment_Analysis_Thesis.Models.Order>



@{ ViewData["Title"] = "Lista zamówień";
   var statuses = new List<string> { "Pending", "Processing", "Completed" };
}



<div class="page-container">
    <h2>@ViewData["Title"]</h2>


    <form method="get" asp-action="Index" asp-controller="Orders">

        <input type="date" name="orderDate" class="form-control" />

        <select name="status" class="form-control">

               <option value="">Wszystkie</option>

                @foreach (var status in statuses)
                {

                    <option value="@status" selected="@(ViewContext.HttpContext.Request.Query["status"] == status ? "selected" : null)">@status</option>

                }

       </select>

        <button type="submit" class="btn btn-primary mt-2 ">Filtruj</button>
    </form>


    <div class="table-container">
        <table class="orders-table">
            <thead>
                <tr>
                    <th>Nr</th>
                    <th>Klient</th>
                    <th>Data zamówienia</th>
                    <th>Kwota</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>
                        <td>@order.Customer.FirstName @order.Customer.LastName</td>
                        <td>@order.OrderDate.ToString("dd.MM.yyyy")</td>
                        <td>@order.TotalAmount.ToString("C")</td>
                        <td>@order.Status</td>
                            
                       
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


<style>

    .page-container {
        padding: 2rem;
        font-family: 'Segoe UI', Roboto, sans-serif;
        color: #333;
    }

    h2 {
        font-size: 1.75rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        color: #1f2937; /* szary 800 */
    }

    /* Tabela */
    .table-container {
        overflow-x: auto;
        border: 1px solid #e5e7eb; /* szary 200 */
        border-radius: 0.75rem;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        background-color: #fff;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
        min-width: 600px;
    }

        .orders-table thead {
            background-color: #f9fafb; /* szary 50 */
            text-transform: uppercase;
            font-size: 0.75rem;
            font-weight: 600;
            color: #374151; /* szary 700 */
        }

        .orders-table th,
        .orders-table td {
            padding: 0.75rem 1.5rem;
            border-bottom: 1px solid #e5e7eb;
            text-align: left;
        }

        .orders-table tbody tr:hover {
            background-color: #f3f4f6; /* szary 100 */
            transition: background-color 0.2s ease-in-out;
        }

    /* Statusy */
    .status {
        display: inline-block;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }

    .status-success {
        background-color: #dcfce7; /* zielony 100 */
        color: #166534; /* zielony 800 */
    }

    .status-warning {
        background-color: #fef9c3; /* żółty 100 */
        color: #92400e; /* żółty 800 */
    }

    .status-error {
        background-color: #fee2e2; /* czerwony 100 */
        color: #991b1b; /* czerwony 800 */
    }
</style>